# ------------------------------------------------------------------
# Root environment - used by docker-compose.yml (local dev database).
# Copy to `.env` and fill in values. NEVER commit the real .env (C4/C11).
# ------------------------------------------------------------------

# PostgreSQL + PostGIS container credentials
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=urbanflow
# Host port mapped to the container's 5432 (5433 avoids clashing with a
# locally installed PostgreSQL that already listens on 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------
# OpenTripPlanner — moteur de routage transports en commun (UF-301)
# ------------------------------------------------------------------

# Version de l'image OpenTripPlanner (épinglée : une montée de version
# invalide le graphe sérialisé et impose une reconstruction).
OTP_VERSION=2.7.0
# Port hôte exposant l'API et l'interface de debug d'OTP.
OTP_PORT=8080
# Mémoire maximale de la JVM pour la construction du graphe. 6g couvrent
# l'agglomération lyonnaise ; à baisser si Docker Desktop dispose de moins.
OTP_MAX_MEMORY=6g
# Mettre à 1 pour forcer la reconstruction du graphe au prochain démarrage
# (utilisé par la procédure de mise à jour mensuelle du GTFS).
OTP_FORCE_REBUILD=0

# Identifiants data.grandlyon.com (compte gratuit) — FACULTATIFS.
# Sans eux, fetch-data.sh utilise le miroir public Mobility Database, qui est
# un instantané daté du GTFS TCL. Avec eux, le flux officiel à jour est
# téléchargé. Voir docs/otp-gtfs.md.
GRANDLYON_USER=
GRANDLYON_PASSWORD=
