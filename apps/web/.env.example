# ------------------------------------------------------------------
# UrbanFlow Web (PWA) - environment variables.
# Copy to `.env` (or `.env.local`). NEVER commit real env files (C4/C11).
# Only NEXT_PUBLIC_* variables are exposed to the browser - no secrets here.
# ------------------------------------------------------------------

# Base URL of the NestJS API Gateway (includes the /api global prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
