# ------------------------------------------------------------------
# UrbanFlow Web (PWA) - environment variables.
# Copy to `.env` (or `.env.local`). NEVER commit real env files (C4/C11).
# Only NEXT_PUBLIC_* variables are exposed to the browser - no secrets here.
# ------------------------------------------------------------------

# Base URL of the NestJS API Gateway (includes the /api global prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------------------------------
# Map tiles (UF-201) - see apps/web/components/map/README.md
# Both are optional: with neither, the map falls back to free OpenStreetMap
# raster tiles (fine for local dev / demo, NOT for production).
# ------------------------------------------------------------------

# MapTiler account key -> vector basemap. Free tier, no card required.
# This value ships to the browser (every map key does): restrict it to the
# app's domains in the MapTiler dashboard - that is the real protection (C4).
NEXT_PUBLIC_MAPTILER_KEY=

# Full MapLibre style URL - takes precedence over the key above.
# Use it for self-hosted tiles or another provider.
NEXT_PUBLIC_MAP_STYLE_URL=
