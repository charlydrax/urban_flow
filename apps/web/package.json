{
  "name": "@urbanflow/web",
  "version": "0.1.0",
  "private": true,
  "description": "UrbanFlow Mobility - PWA client (Next.js App Router + MapLibre GL JS)",
  "scripts": {
    "dev": "npm run build:sw && next dev",
    "build": "npm run build:sw && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "vitest run --project a11y",
    "test:watch": "vitest",
    "build:sw": "esbuild sw.ts --bundle --minify --outfile=public/sw.js",
    "eco:budget": "node scripts/eco-budget.mjs",
    "typecheck:sw": "tsc -p tsconfig.sw.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css}": "prettier --write"
  },
  "dependencies": {
    "@urbanflow/shared": "*",
    "maplibre-gl": "^5.6.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.0",
    "eslint-config-next": "^15.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
