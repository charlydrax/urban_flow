# ------------------------------------------------------------------
# UrbanFlow API - environment variables.
# Copy to `.env` and fill in values. NEVER commit the real .env (C4/C11).
# All variables are validated at startup (src/config/env.validation.ts).
# ------------------------------------------------------------------

# HTTP port of the API Gateway
PORT=3001

# Allowed origin for CORS (the Next.js PWA in dev)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL + PostGIS connection string (matches docker-compose.yml at repo root,
# host port 5433 by default - see root .env.example)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://urbanflow:change-me-strong-password@localhost:5433/urbanflow?schema=public

# Secret used to sign JWT access tokens (C4/C11).
# Generate a strong value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-secret

# JWT access token lifetime (e.g. 900s, 15m, 1h)
JWT_EXPIRES_IN=15m
