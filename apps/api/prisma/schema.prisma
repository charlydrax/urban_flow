// Schéma Prisma — UrbanFlow Mobility.
//
// Base PostgreSQL + extension PostGIS (activée par la migration initiale :
// `CREATE EXTENSION IF NOT EXISTS postgis`). Les requêtes géospatiales
// (ex. ST_DWithin pour les pistes cyclables) passeront par $queryRaw car
// Prisma ne couvre pas nativement les types geometry.
//
// RGPD (C8) : chaque champ contenant une donnée personnelle est annoté.
// Le droit à l'effacement est garanti par les suppressions en cascade :
// supprimer un User efface son profil de mobilité et tout son historique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte utilisateur (F1).
/// RGPD (C8) : table de données personnelles — minimisation appliquée,
/// seuls l'email et le hash du mot de passe sont stockés.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// RGPD (C8) : donnée personnelle (identifiant de contact). Jamais journalisée (C11).
  email        String    @unique
  /// Hash argon2 du mot de passe (C4) — jamais le mot de passe en clair.
  passwordHash String    @map("password_hash")
  /// RGPD (C8) : horodatage du consentement explicite (géolocalisation, CGU).
  consentAt    DateTime? @map("consent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  mobilityProfile MobilityProfile?
  searchHistory   SearchHistory[]

  @@map("users")
}

/// Préférences de mobilité (F1), lues par le planificateur (F2) à l'étape 3 du flux.
model MobilityProfile {
  id     String @id @default(uuid()) @db.Uuid
  /// Cascade : l'effacement du compte emporte le profil (droit à l'effacement — C8).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @map("user_id") @db.Uuid

  /// Modes acceptés (valeurs de l'enum TransportMode côté API).
  preferredModes  String[] @map("preferred_modes")
  /// Priorité de calcul d'itinéraire (valeurs de l'enum RoutePriority côté API) :
  /// FASTEST (rapide) ou GREENEST (écolo). Lue par le planificateur (F2, étape 3
  /// du flux) pour trier les options. Défaut « écolo », cohérent avec la
  /// proposition de valeur du produit (orienter vers les mobilités douces).
  priority        String   @default("GREENEST") @map("priority")
  /// RGPD (C8) : donnée sensible (situation de handicap) — collectée uniquement
  /// pour proposer des itinéraires accessibles PMR (C12), jamais journalisée (C11).
  reducedMobility Boolean  @default(false) @map("reduced_mobility")
  /// Marche maximale acceptée par segment, en minutes.
  maxWalkMinutes  Int      @default(15) @map("max_walk_minutes")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("mobility_profiles")
}

/// Historique des recherches d'itinéraires (étape 7 du flux, UF-204) — alimente
/// les trajets récents du planificateur et le tableau de bord carbone personnel.
/// RGPD (C8) : les déplacements sont des données personnelles sensibles par
/// recoupement — accès restreint au propriétaire, purge en cascade avec le compte,
/// politique de rétention à définir (C11 : chiffrement au repos côté hébergeur).
///
/// ⚠️ Les deux extrémités sont des **géométries PostGIS**, pas des colonnes
/// flottantes : c'est ce qui rendra possible, sans migration ultérieure, les
/// requêtes du domaine (« mes trajets récents partant d'ici », `ST_DWithin`,
/// agrégats par zone). Prisma ne typant pas `geometry`, elles sont déclarées
/// `Unsupported` et le module `search-history` les lit/écrit en SQL brut
/// (`ST_MakePoint`, `ST_X`/`ST_Y`) — même parti pris que `ST_DWithin` côté
/// itinéraires (cf. commentaire d'en-tête).
model SearchHistory {
  id     String @id @default(uuid()) @db.Uuid
  /// Cascade : droit à l'effacement (C8).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid

  /// RGPD (C8) : lieu de départ saisi (donnée de déplacement).
  fromLabel String                               @map("from_label")
  /// Point WGS84 (SRID 4326) du départ — géolocalisation (C6), géospatial (C9).
  fromGeom  Unsupported("geometry(Point, 4326)") @map("from_geom")
  /// RGPD (C8) : lieu d'arrivée saisi (donnée de déplacement).
  toLabel   String                               @map("to_label")
  /// Point WGS84 (SRID 4326) de l'arrivée.
  toGeom    Unsupported("geometry(Point, 4326)") @map("to_geom")

  /// Résumé de l'itinéraire retenu (ex. "Marche + Métro B").
  selectedSummary String? @map("selected_summary")
  /// Empreinte CO₂ de l'option retenue, en grammes — alimente le dashboard carbone.
  carbonGrams     Int?    @map("carbon_grams")
  /// Ce que le **même** trajet aurait coûté seul en voiture, en grammes (UF-505).
  ///
  /// Stockée plutôt que recalculée à la lecture, pour deux raisons. D'abord la
  /// distance parcourue n'est pas conservée ici — seuls les deux points le
  /// sont, et la distance à vol d'oiseau n'est pas celle du trajet réel.
  /// Ensuite le barème (`emission-factors.ts`) est explicitement provisoire :
  /// un bilan personnel dont les mois passés changeraient à chaque affinage du
  /// barème ne serait pas un historique. Les deux colonnes sont donc écrites
  /// ensemble, au barème du jour du trajet, et ne bougent plus.
  ///
  /// `NULL` en même temps que `carbonGrams` : les deux naissent du même choix
  /// d'itinéraire, il n'existe pas d'état où l'une serait connue sans l'autre.
  carEquivalentGrams Int? @map("car_equivalent_grams")

  createdAt DateTime @default(now()) @map("created_at")

  /// Lecture nominale : « les N dernières recherches de CET utilisateur »
  /// (`WHERE user_id = … ORDER BY created_at DESC`) — l'index couvre les deux.
  @@index([userId, createdAt])
  /// Index spatial GiST sur le départ : sans lui, stocker des `geometry` plutôt
  /// que deux flottants n'apporterait rien de plus qu'un type mieux nommé.
  /// Il rend indexables les requêtes de proximité à venir (« trajets récents
  /// partant d'ici », `ST_DWithin`) — cf. étape 4 du flux de référence.
  @@index([fromGeom(ops: raw("gist_geometry_ops_2d"))], type: Gist)
  @@map("search_history")
}

/// Aménagements cyclables de la Métropole de Lyon (UF-304) — troisième source du
/// `Promise.all` de l'étape 4 du flux, aux côtés de GTFS et GBFS.
///
/// Contrairement aux deux autres, celle-ci est **persistée chez nous** : le
/// réseau cyclable est une donnée de patrimoine qui bouge de quelques dizaines
/// de tronçons par an, pas un flux temps réel. L'interroger en base plutôt qu'à
/// chaque requête chez un tiers supprime une latence réseau et un point de panne
/// du chemin critique du planificateur (C5/C10) — et c'est ce qui rend
/// `ST_DWithin` pertinent ici, là où les stations GBFS restent en mémoire.
///
/// RGPD (C8) : aucune donnée personnelle — patrimoine public sous Licence
/// Ouverte. C'est la seule table du schéma qui puisse être purgée et réimportée
/// sans conséquence.
model CyclePath {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant du tronçon chez le producteur (`gid` du flux Grand Lyon).
  /// Unique : c'est la clé de rapprochement qui rend le réimport idempotent
  /// (un tronçon corrigé est mis à jour, pas dupliqué).
  sourceId String @unique @map("source_id")

  /// Voie empruntée (« Rue Garibaldi »), `null` pour un tronçon hors voirie
  /// nommée (traversée de parc, passerelle).
  name String?

  /// Type d'aménagement tel que publié : « Piste Cyclable », « Bande Cyclable »,
  /// « Voie verte », « Double sens cyclable »… Conservé parce qu'une piste
  /// séparée de la circulation et une bande peinte au sol n'offrent ni la même
  /// sécurité ni le même confort — le planificateur (F2) doit pouvoir les
  /// pondérer différemment.
  facilityType String @map("facility_type")

  /// Niveau de réseau (« Voies Lyonnaises », « Réseau structurant… ») : distingue
  /// les axes express continus des dessertes de quartier.
  network String? @map("network")

  /// Revêtement (« Matériaux liés », « sable compacté »…). Retenu pour C12 :
  /// un stabilisé n'est praticable ni en fauteuil ni par tous les vélos.
  surface String? @map("surface")

  /// Tracé du tronçon.
  ///
  /// ⚠️ `geography` et non `geometry` — à la différence de `search_history`.
  /// C'est le type qui porte la sémantique du ticket : `ST_DWithin` sur une
  /// `geometry(4326)` compte en **degrés** (un rayon de 500 vaudrait ~55 000 km),
  /// alors que sur une `geography` il compte en **mètres** sur l'ellipsoïde.
  /// Caster à la volée (`geom::geography`) donnerait le bon résultat mais
  /// écarterait l'index — la mesure métrique est donc inscrite dans le type,
  /// pas rattrapée dans la requête.
  ///
  /// `MultiLineString` parce que la source en publie : un même aménagement peut
  /// être interrompu (carrefour, tronçon en deux brins). 15 tronçons sur 4 714
  /// sont réellement multi-brins, mais un type unique évite une conversion
  /// fragile à l'import.
  geom Unsupported("geography(MultiLineString, 4326)")

  /// Date du dernier import de ce tronçon — sert à dater la fraîcheur du jeu de
  /// données exposée par l'API, le producteur ne publiant pas d'horodatage.
  importedAt DateTime @default(now()) @map("imported_at")

  /// Index spatial GiST — l'exigence explicite de la recette du ticket, et la
  /// raison d'être de PostGIS ici (C10).
  ///
  /// Sans lui, `ST_DWithin` impose un parcours séquentiel : 4 714 calculs de
  /// distance ellipsoïdale à chaque recherche d'itinéraire. Avec lui, l'index
  /// élimine d'abord par boîtes englobantes et le calcul exact ne porte que sur
  /// une poignée de candidats. L'opclass est celle des `geography`
  /// (`gist_geography_ops`), pas celle des `geometry` du reste du schéma.
  @@index([geom(ops: raw("gist_geography_ops"))], type: Gist)
  @@map("cycle_paths")
}
