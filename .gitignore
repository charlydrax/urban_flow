# Dependencies
node_modules/

# Environment files (secrets must never be committed - C4/C11)
.env
.env.*
!.env.example

# Next.js
.next/
out/
next-env.d.ts

# Build de mesure éco-conception (UF-605) — sortie isolée de `.next/` pour ne
# pas retirer ses chunks au serveur de développement en cours d'exécution.
.next-eco/

# NestJS / TypeScript build output
dist/
*.tsbuildinfo

# Tests & coverage
coverage/
.nyc_output/

# Prisma generated client
apps/api/generated/

# Service worker build output (compiled from sw.ts)
apps/web/public/sw.js
apps/web/public/sw.js.map

# Seed build output — le seed est *toujours* exécuté depuis `prisma/seed.ts`
# via ts-node (clé `prisma.seed` du package.json). Un `.js` compilé à côté de sa
# source n'est jamais lu : c'est un doublon qui se périme en silence.
apps/api/prisma/seed.js
apps/api/prisma/seed.js.map
apps/api/prisma/seed.d.ts

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Misc
.cache/
.turbo/
